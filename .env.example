# Скопируйте этот файл в .env и заполните. Файл .env НЕ коммитьте и никому не показывайте.

# Токен бота от @BotFather
BOT_TOKEN=

# Токен API Т-Инвестиций. Выпускайте с правом «Только чтение».
TINKOFF_TOKEN=

# Ваш Telegram ID (узнать: @userinfobot). Бот отвечает только вам.
OWNER_ID=

# Отчёты по расписанию, время московское, через запятую. off — выключить.
REPORT_TIMES=10:05,16:05,19:05
# 1 — отчёты только по будням, 0 — каждый день
REPORT_WEEKDAYS_ONLY=1

# Как часто проверять цены и уровни из /alert, секунд (минимум 60)
CHECK_INTERVAL=300

# Как часто собирать новости из каналов и лент, секунд (минимум 120)
NEWS_INTERVAL=600

# Файл сертификатов, если ваша сеть требует корень Минцифры.
# Пусто — бот сам поищет ca_bundle.pem в папке проекта и рядом с ней.
CA_BUNDLE=

# 1 — ходить в интернет через системный прокси Windows (если VPN-клиент работает как прокси
# и без этого не открываются t.me или другие сайты). 0 — напрямую, как раньше.
USE_SYSTEM_PROXY=0
